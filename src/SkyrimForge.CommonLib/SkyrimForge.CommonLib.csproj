<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The bindings are generated by SkyrimForge.BindingGenerator, a tool outside this repository.
    A separate project so that the authored code in SkyrimForge.Game compiles without recompiling the bindings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SkyrimForge.Game</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyrimForge\SkyrimForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkyrimForge.Game" />
    <InternalsVisibleTo Include="SkyrimForge.Tests" />
    <InternalsVisibleTo Include="SkyrimForge.PluginHost" />
    <InternalsVisibleTo Include="SkyrimForge.ApiSanityCheck" />
  </ItemGroup>

</Project>
